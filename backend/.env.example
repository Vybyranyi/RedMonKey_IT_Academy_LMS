# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────────
# Щоденна розробка — локальний Postgres (`docker compose up db`), а не Supabase:
# проєкт Supabase один на прод і розробку, а `npm run seed` стирає базу.
DATABASE_URL="postgresql://lms:lms@localhost:5433/lms"
DIRECT_URL="postgresql://lms:lms@localhost:5433/lms"

# Supabase (прод, демо): Connect → ORMs → Prisma.
# DATABASE_URL — Transaction pooler (6543) для запитів застосунку.
# DIRECT_URL   — Session pooler (5432) для `prisma migrate`. Не Direct connection
#                (db.<ref>.supabase.co): вона лише IPv6, з багатьох мереж недоступна.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Storage (аватарки) ──────────────────────────
# Project Settings → API Keys: Project URL і Secret key (sb_secret_...).
# Необов'язково: без них усе працює, лише завантаження аватарок відповідає 503.
# Секретний ключ — лише для backend, ніколи у frontend/.env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_AVATAR_BUCKET=avatars

# ─── JWT ──────────────────────────────────────────────────
# Секрети мають бути ≥ 32 символи і різними. Генерація:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Proxy ────────────────────────────────────────────────
# Кількість проксі перед backend. Локально — 0. За Render/Railway/Nginx — 1:
# інакше rate-limit бачитиме IP балансувальника замість IP клієнта, і всі
# користувачі ділитимуть один ліміт на логін.
TRUST_PROXY=0

# ─── Static frontend ──────────────────────────────────────
# Тека зі зібраним frontend (frontend/dist). Задана — backend віддає ще й фронт
# з того ж домену. Docker-образ виставляє її сам; локально залиш порожньою.
STATIC_DIR=

# ─── Перший адмін (npm run create-admin, на проді — старт контейнера) ─
# Створює адміна, лише якщо активного адміна в базі ще немає. Seed не потрібен.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Адміністратор
# ADMIN_LAST_NAME=Академії

# ─── Seed ─────────────────────────────────────────────────
SEED_PASSWORD=Password123!
