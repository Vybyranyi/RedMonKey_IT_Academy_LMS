{
  "name": "redmonkey-it-academy-lms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "predev": "npm run build -w @redmonkey/shared",
    "dev": "concurrently -c \"cyan.bold,blue.bold,green.bold\" -n \"SHARED,BACKEND,FRONTEND\" \"npm run dev -w @redmonkey/shared\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.9.9"
  }
}
